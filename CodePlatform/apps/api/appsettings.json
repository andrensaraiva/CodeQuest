{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=codequest;Username=codequest;Password=codequest",
    "SqliteConnection": "Data Source=codequest-dev.db"
  },
  "Jwt": {
    "Issuer": "CodeQuestAcademy",
    "Key": "",
    "ExpirationHours": 12
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://127.0.0.1:5173" ]
  },
  "Database": {
    "Provider": "Postgres",
    "AutoMigrate": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "CodeRunner": {
    "Provider": "Mock",
    "TimeoutSeconds": 5
  },
  "AllowedHosts": "*"
}
